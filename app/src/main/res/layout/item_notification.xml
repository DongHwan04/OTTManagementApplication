<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="12dp">

    <!-- 날짜 (10.12) -->
    <TextView
        android:id="@+id/tv_noti_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:includeFontPadding="false"
        android:textColor="#191F28"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="10.12" />

    <!-- 요일 (MON) -->
    <TextView
        android:id="@+id/tv_noti_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:includeFontPadding="false"
        android:textColor="#333D4B"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_noti_date"
        app:layout_constraintStart_toEndOf="@id/tv_noti_date"
        tools:text="MON" />

    <!-- 미확인 빨간 점 (Red Dot) -->
    <View
        android:id="@+id/view_noti_unread_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="1dp"
        android:background="@drawable/bg_red_dot"
        app:layout_constraintBottom_toTopOf="@id/tv_noti_day"
        app:layout_constraintStart_toEndOf="@id/tv_noti_day"
        app:layout_constraintTop_toTopOf="@id/tv_noti_date" />

    <!-- 서비스 아이콘 표준: MaterialCardView + ImageView -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_noti_service_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/divider_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_noti_date"
        app:strokeColor="#E5E8EB"
        app:strokeWidth="1.5dp">

        <ImageView
            android:id="@+id/iv_noti_service_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="구독 서비스 아이콘"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_disneyplus" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 서비스명 (볼드) -->
    <TextView
        android:id="@+id/tv_noti_service_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#191F28"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tv_noti_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_noti_service_icon"
        app:layout_constraintTop_toTopOf="@id/card_noti_service_icon"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="디즈니 플러스" />

    <!-- 알림 본문 -->
    <TextView
        android:id="@+id/tv_noti_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#333D4B"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/card_noti_service_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_noti_service_icon"
        app:layout_constraintTop_toBottomOf="@id/tv_noti_service_name"
        tools:text="소비 효율이 저번 달 대비 30% 감소했습니다." />

    <!-- 하단 구분선 -->
    <View
        android:id="@+id/divider_item"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E5E8EB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>