<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">

    <!-- 서비스 아이콘 표준: MaterialCardView + ImageView -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_profile_sub_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#E5E8EB"
        app:strokeWidth="1.5dp">

        <ImageView
            android:id="@+id/iv_profile_sub_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="구독 서비스 아이콘"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_youtube" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 상단 지출 비율 프로그레스 바 -->
    <ProgressBar
        android:id="@+id/progress_profile_sub_ratio"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="7dp"
        android:layout_marginStart="12dp"
        android:max="100"
        android:progressDrawable="@drawable/bg_subscription_ratio_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_profile_sub_icon"
        app:layout_constraintTop_toTopOf="@id/card_profile_sub_icon"
        tools:progress="75" />

    <!-- 좌측 하단: 서비스명 -->
    <TextView
        android:id="@+id/tv_profile_sub_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#191F28"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/card_profile_sub_icon"
        app:layout_constraintEnd_toStartOf="@id/tv_profile_sub_price"
        app:layout_constraintStart_toEndOf="@id/card_profile_sub_icon"
        tools:text="유튜브 프리미엄" />

    <!-- 우측 하단: 월 구독 금액 -->
    <TextView
        android:id="@+id/tv_profile_sub_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#191F28"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/card_profile_sub_icon"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="14,900" />

</androidx.constraintlayout.widget.ConstraintLayout>