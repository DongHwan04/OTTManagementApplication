<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:orientation="vertical">

    <!-- 총 지출 요약 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#E5E8EB"
        app:strokeWidth="2dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tv_month_state_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="10월"
                android:textColor="#191F28"
                android:textSize="20sp"
                android:textStyle="bold" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_month_state_summary"
                app:layout_constraintStart_toStartOf="@id/tv_month_state_summary"
                android:orientation="vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tv_state_total_amount_description"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이번 달 총 지출"
                    android:textColor="#6B7684"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_state_total_amount_KRW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/tv_state_total_amount_description"
                    app:layout_constraintTop_toTopOf="@id/tv_state_total_amount_description"
                    android:layout_marginHorizontal="10dp"
                    android:text="KRW"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    />

                <TextView
                    android:id="@+id/tv_total_monthly_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tv_state_total_amount_description"
                    app:layout_constraintEnd_toEndOf="@id/tv_state_total_amount_KRW"
                    android:text="54,700"
                    android:textColor="#191F28"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_month_state_summary"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tv_state_total_efficient_description"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이번 달 총 지출"
                    android:textColor="#6B7684"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_state_total_efficient_KRW_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/tv_state_total_efficient_description"
                    app:layout_constraintTop_toTopOf="@id/tv_state_total_efficient_description"
                    android:layout_marginHorizontal="10dp"
                    android:text="KRW / h"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    />

                <TextView
                    android:id="@+id/tv_total_monthly_efficient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tv_state_total_efficient_description"
                    app:layout_constraintEnd_toEndOf="@id/tv_state_total_efficient_KRW_h"
                    android:text="54,700"
                    android:textColor="#191F28"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </androidx.constraintlayout.widget.ConstraintLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>

    <!-- 하단 차트 / 카테고리별 분석 영역 (추후 그래프 라이브러리 또는 커스텀 뷰 배치) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#E5E8EB"
        app:strokeWidth="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="서비스별 지출 비율 차트 영역"
            android:textColor="#8B95A1"
            android:textSize="14sp" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>