<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ProfileFragment">

    <!-- 1. 상단 툴바 (캘린더 / 내 페이지 / 알림 / 검색) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_profile_toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_profile_calendar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="캘린더 이동"
            android:src="@drawable/ic_calendar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#191F28" />

        <TextView
            android:id="@+id/tv_profile_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 페이지"
            android:textColor="#191F28"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/btn_profile_notification"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="내 알림"
                android:src="@drawable/ic_alarm"
                app:tint="#191F28" />

            <View
                android:id="@+id/view_profile_bell_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="11dp"
                android:background="@drawable/bg_red_dot" />
        </FrameLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider_profile_toolbar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E5E8EB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_profile_toolbar" />

    <!-- 2. 공통 VIDEO / MUSIC 필터 바 -->
    <include
        android:id="@+id/include_category_filter"
        layout="@layout/layout_category_filter_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginVertical="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider_profile_toolbar" />

    <!-- 3. 하단 스크롤 프로필 & 구독 요약 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_profile_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_category_filter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="88dp">

            <!-- 3-1. 유저 프로필 헤더 영역 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp">

                <ImageButton
                    android:id="@+id/btn_profile_edit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="프로필 수정"
                    android:src="@drawable/ic_edit_pencil"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#4E5968" />

                <ImageView
                    android:id="@+id/iv_profile_avatar"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="프로필 이미지"
                    android:src="@drawable/ic_person_avatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 겹치는 구독 서비스 아이콘 + 닉네임(#0000) 행 -->
                <LinearLayout
                    android:id="@+id/layout_profile_identity_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_profile_avatar">

                    <!-- 마지막 아이콘 잘림 방지: clipToPadding=false + paddingEnd=8dp -->
                    <LinearLayout
                        android:id="@+id/ll_profile_overlapping_icons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:clipToPadding="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_profile_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="#191F28"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_user_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="#0000"
                        android:textColor="#8B95A1"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 3-2. 총 금액 · 총 효율 · 목표 효율 카드 (라이트 톤 테두리 카드) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F9FAFB"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E8EB"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 상단 2열 요약 (총 금액 | 총 효율) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- 좌측: 총 금액 -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/label_profile_total_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="총 금액"
                                android:textColor="#191F28"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_profile_unit_krw"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KRW"
                                android:textColor="#D9779B"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_profile_total_amount_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#191F28"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_profile_unit_krw"
                                tools:text="45,000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="이용자 평균 금액"
                                android:textColor="#8B95A1"
                                android:textSize="11sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_profile_total_amount_value" />

                            <TextView
                                android:id="@+id/tv_profile_avg_amount_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="97,000"
                                android:textColor="#6B7684"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_profile_total_amount_value" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- 세로 구분선 -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#E5E8EB" />

                        <!-- 우측: 총 효율 -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/label_profile_total_efficiency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="총 효율"
                                android:textColor="#191F28"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_profile_unit_krw_per_h"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KRW / h"
                                android:textColor="#48B84E"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_profile_total_efficiency_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#191F28"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_profile_unit_krw_per_h"
                                tools:text="4,000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="이용자 평균 효율"
                                android:textColor="#8B95A1"
                                android:textSize="11sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_profile_total_efficiency_value" />

                            <TextView
                                android:id="@+id/tv_profile_avg_efficiency_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="3,400"
                                android:textColor="#6B7684"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_profile_total_efficiency_value" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="#E5E8EB" />

                    <!-- 하단: 목표 효율 비교 영역 (클릭 시 목표 효율 수정 다이얼로그) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_profile_target_efficiency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp">

                        <TextView
                            android:id="@+id/label_profile_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="목표 효율"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_profile_target_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#191F28"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/label_profile_target"
                            tools:text="2,500" />

                        <TextView
                            android:id="@+id/tv_profile_target_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="KRW / h"
                            android:textColor="#48B84E"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintBaseline_toBaselineOf="@id/tv_profile_target_value"
                            app:layout_constraintStart_toEndOf="@id/tv_profile_target_value" />

                        <!-- 우측 비교 막대 2개 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tv_profile_target_unit"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tv_bar_current_efficiency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:textColor="#333D4B"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="4,000" />

                            <ProgressBar
                                android:id="@+id/progress_current_efficiency"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="2dp"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@drawable/bg_profile_progress_green" />

                            <TextView
                                android:id="@+id/tv_bar_target_efficiency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="6dp"
                                android:textColor="#333D4B"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="2,500" />

                            <ProgressBar
                                android:id="@+id/progress_target_efficiency"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="2dp"
                                android:max="100"
                                android:progress="65"
                                android:progressDrawable="@drawable/bg_profile_progress_target" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3-3. 구독 서비스별 지출 비율 목록 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_profile_subscriptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_profile_subscription" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 4. 우측 하단 원형 + FAB 버튼 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_profile_add_subscription"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="구독 추가"
        android:src="@drawable/ic_add"
        app:backgroundTint="#A6A6A6"
        app:elevation="2dp"
        app:fabCustomSize="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="28dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>