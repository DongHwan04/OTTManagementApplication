<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainStatesFragment">

    <!-- 최상단 가로 구독 아이콘 리스트 (왼쪽 끝 밀착) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_subscription_icons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:itemCount="5"
        tools:listitem="@layout/layout_states_icons_top" />

    <!-- 하단 스크롤 통계 영역 (아이콘 리스트 아래부터 바닥까지) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_stats_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_subscription_icons">

        <LinearLayout
            android:id="@+id/ll_stats_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- 1. 개별 서비스 통계 카드 (초기에는 숨김 처리) -->
            <include
                android:id="@+id/include_individual_stats"
                layout="@layout/layout_stats_individual_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- 2. 전체 구독 통계 영역 (항상 표시) -->
            <include
                android:id="@+id/include_total_stats"
                layout="@layout/layout_stats_total_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />



        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>