<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:background="?attr/selectableItemBackground">

    <!-- 좌측 상단 원형 테두리 날짜 배지 -->
    <TextView
        android:id="@+id/tv_calendar_day_number"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_calendar_day_circle"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12"
        tools:textColor="#191F28" />

    <!-- 결제 일정 배지 1 (예: ● 넷플...) -->
    <LinearLayout
        android:id="@+id/layout_cal_event_1"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:layout_marginHorizontal="3dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_calendar_event_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/divider_cell_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_calendar_day_number"
        tools:visibility="visible">

        <View
            android:id="@+id/view_cal_event_dot_1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_event_dot" />

        <TextView
            android:id="@+id/tv_cal_event_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#191F28"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="넷플릭스" />
    </LinearLayout>

    <!-- 결제 일정 배지 2 (예: ● 유튜...) -->
    <LinearLayout
        android:id="@+id/layout_cal_event_2"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:layout_marginHorizontal="3dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_calendar_event_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/divider_cell_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_cal_event_1"
        tools:visibility="visible">

        <View
            android:id="@+id/view_cal_event_dot_2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_event_dot" />

        <TextView
            android:id="@+id/tv_cal_event_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#191F28"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="유튜브" />
    </LinearLayout>

    <!-- 셀 우측 세로 격자선 -->
    <View
        android:id="@+id/divider_cell_right"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#B0B8C1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 셀 하단 가로 격자선 -->
    <View
        android:id="@+id/divider_cell_bottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#B0B8C1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>