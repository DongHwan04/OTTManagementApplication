<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 1. 상단 툴바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_community_toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_community_calendar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="캘린더 이동"
            android:src="@drawable/ic_calendar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#191F28" />

        <TextView
            android:id="@+id/tv_community_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="커뮤니티"
            android:textColor="#191F28"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/btn_community_notification"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="내 알림"
                android:src="@drawable/ic_alarm"
                app:tint="#191F28" />

            <View
                android:id="@+id/view_community_bell_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="11dp"
                android:background="@drawable/bg_red_dot" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider_community_toolbar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E5E8EB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_community_toolbar" />

    <!-- 2-1. VIDEO / MUSIC 필터 바 -->
    <include
        android:id="@+id/include_category_filter"
        layout="@layout/layout_category_filter_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_community_toolbar" />

    <!-- 2-2. 2행 필터: 게시글 말머리 ([전체], [추천], [후기], [팁]) -->
    <HorizontalScrollView
        android:id="@+id/scroll_community_type_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_category_filter">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/chip_type_all"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_type_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_post_type_chip"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="64dp"
                    android:paddingHorizontal="16dp"
                    android:text="전체"
                    android:textColor="#191F28"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chip_type_recommend"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_type_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_post_type_chip"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="64dp"
                    android:paddingHorizontal="16dp"
                    android:text="추천"
                    android:textColor="#191F28"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chip_type_review"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_type_review"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_post_type_chip"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="64dp"
                    android:paddingHorizontal="16dp"
                    android:text="후기"
                    android:textColor="#191F28"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chip_type_tip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_type_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_post_type_chip"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="64dp"
                    android:paddingHorizontal="16dp"
                    android:text="팁"
                    android:textColor="#191F28"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. 게시글 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_community_posts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_community_type_filters"
        tools:itemCount="5"
        tools:listitem="@layout/item_community_post" />

    <TextView
        android:id="@+id/tv_community_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="조건에 맞는 게시글이 없습니다."
        android:textColor="#8B95A1"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_community_type_filters" />

</androidx.constraintlayout.widget.ConstraintLayout>